{
  "name": "contextlayer",
  "version": "0.0.0",
  "private": true,
  "description": "Digital Adoption Platform: interactive, in-app guides for existing web applications.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "pnpm --recursive --if-present run lint",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --recursive --workspace-concurrency=1 --if-present run test:e2e",
    "test:e2e:install": "pnpm --filter @contextlayer/dashboard exec playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @contextlayer/api run db:generate",
    "db:migrate": "pnpm --filter @contextlayer/api run db:migrate",
    "demo:site": "pnpm --filter @contextlayer/extension demo:site"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "vitest": "catalog:"
  }
}
