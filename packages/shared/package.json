{
  "name": "@contextlayer/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-validated contracts (zod schemas and inferred types) shared by the API, dashboard and extension.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@contextlayer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@contextlayer/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
