{
  "name": "@contextlayer/api",
  "version": "0.0.0",
  "private": true,
  "description": "ContextLayer HTTP API: a Fastify modular monolith backed by PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"../../node_modules/.pnpm/**\" --conditions=@contextlayer/source --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "pnpm --filter @contextlayer/shared run build && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "pnpm --filter @contextlayer/shared run build && drizzle-kit check"
  },
  "dependencies": {
    "@contextlayer/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "close-with-grace": "^2.5.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@contextlayer/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
