{
  "name": "@contextlayer/extension",
  "version": "0.1.0",
  "private": true,
  "description": "ContextLayer Chrome extension (Manifest V3): service worker, content script and popup.",
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=@contextlayer/source scripts/build.ts --watch",
    "build": "tsx --conditions=@contextlayer/source scripts/build.ts",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@contextlayer/shared": "workspace:*",
    "@contextlayer/ui": "workspace:*",
    "vue": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@contextlayer/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/chrome": "^0.3.4",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
