# Copy to `.env` (git-ignored) and adjust if needed: cp .env.example .env
# Every value below is a LOCAL DEVELOPMENT default. Never commit real secrets.

# --- PostgreSQL (compose.yaml) -----------------------------------------------
POSTGRES_USER=contextlayer
POSTGRES_PASSWORD=contextlayer
POSTGRES_DB=contextlayer
POSTGRES_PORT=5432

# --- API (apps/api) ----------------------------------------------------------
# NODE_ENV is deliberately NOT set here: Vite reads this file too, and a
# NODE_ENV in it would turn production builds of the dashboard and extension
# into development builds. The API defaults to `development`; deployments set
# NODE_ENV=production in the process environment.
API_HOST=localhost
API_PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://contextlayer:contextlayer@localhost:5432/contextlayer
# Integration tests create, migrate and truncate this database; its name must
# end with _test. Never point it at the development database above.
TEST_DATABASE_URL=postgres://contextlayer:contextlayer@localhost:5432/contextlayer_test
# The Playwright suites start the built API on :3100 against this database
# (apps/api/scripts/e2e-server.ts): created, migrated and emptied on every run,
# so its name must end with _e2e. Read from the shell, not from this file.
# E2E_DATABASE_URL=postgres://contextlayer:contextlayer@localhost:5432/contextlayer_e2e
# Dashboard origins allowed to send cookie-authenticated POST/PUT/PATCH/DELETE
# (CSRF guard). Defaults to the Vite dev and preview servers outside production;
# required in production.
DASHBOARD_ORIGIN=http://localhost:5173,http://localhost:4173
# Session lifetimes (ADR 0015).
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Auth rate limits: login per client IP + email, registration per client IP.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20
# Reverse-proxy addresses whose X-Forwarded-For is trusted (empty: none).
TRUST_PROXY=

# --- Dashboard (apps/dashboard) ----------------------------------------------
# The Vite dev/preview server proxies /api/* to this origin (same-origin model).
DASHBOARD_API_PROXY_TARGET=http://localhost:3000

# --- Extension (apps/extension) ----------------------------------------------
# Baked in at build time. Also used to derive the manifest host_permissions.
# http is only accepted for localhost; a remote API must use https.
EXTENSION_API_BASE_URL=http://localhost:3000
# The dashboard that completes "Connect to ContextLayer". Only this exact origin
# (port included) may message the extension (externally_connectable), and the
# extension opens its /extension/connect page. https outside localhost.
EXTENSION_DASHBOARD_URL=http://localhost:5173
# Extension identity. Unset = the committed development key and its id
# (packages/shared/src/extension-identity.ts), the same for every clone and CI.
# A production build sets both: the base64 DER public key (manifest "key") and
# the id Chrome derives from it; the build fails if they do not match.
# The dashboard reads EXTENSION_ID too (the extension it hands codes to), and the
# API requires it in production (the only client id it issues tokens to).
# EXTENSION_PUBLIC_KEY=
# EXTENSION_ID=
